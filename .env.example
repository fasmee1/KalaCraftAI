MONGODB_URI=
# ค่าย AI ที่ใช้แก้รูป: cloudflare (ค่าเริ่มต้น, มีโควตาฟรีรายวัน) | gemini (เสียเงิน)
AI_PROVIDER=cloudflare
# Cloudflare Workers AI — Account ID จาก dash.cloudflare.com, token จาก My Profile → API Tokens → template "Workers AI"
# ใช้ฝั่ง server เท่านั้น
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
# โมเดลเมื่อลูกค้าพิมพ์ "บอก AI เพิ่มเติม" — ตัวใหญ่กว่า ทำตามคำขอได้ แต่ใช้โควตามากกว่า ~10 เท่า
CLOUDFLARE_EDIT_MODEL=@cf/black-forest-labs/flux-2-klein-9b
# Google Gemini (Nano Banana) — สร้าง key ที่ https://aistudio.google.com/apikey ใช้ฝั่ง server เท่านั้น
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# ลูกค้าล็อกอินด้วย Google (ไม่บังคับ) — สร้างที่ Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google  ใช้ฝั่ง server เท่านั้น — เว้นว่าง = ปิดการล็อกอิน Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (เก็บเฉพาะรูปต้นแบบสินค้า ไม่เก็บรูปผลลัพธ์ของลูกค้า) — ใช้ฝั่ง server เท่านั้น
# ดูค่าได้ที่ Cloudinary Console → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# โฟลเดอร์หลักที่ใช้เก็บรูปของระบบ
CLOUDINARY_FOLDER=kalacraft

# Cloudflare Turnstile — ตอน dev ใช้ test key ที่ผ่านเสมอ: secret 1x0000000000000000000000000000000AA / site 1x00000000000000000000AA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_FB_PAGE=
# salt สำหรับ hash IP ของลูกค้า (สุ่มยาว ๆ, ห้ามเปลี่ยนบ่อย)
IP_HASH_SALT=
# จำนวนครั้งที่สร้างได้ต่อวัน: ไม่ล็อกอิน (นับต่อ IP) / ล็อกอินด้วย Google (นับต่อบัญชี)
RATE_LIMIT_PER_DAY=2
RATE_LIMIT_PER_DAY_USER=10
DAILY_BUDGET_USD=10
